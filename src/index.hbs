<div class="bingo-landing">
  <header class="bingo-hero">
    <h1 class="bingo-hero__title">Unihack Photo Hunt</h1>
    <p class="bingo-hero__tagline">
      Get a 3×3 grid of Unihack-themed prompts, hunt for photos around the venue, and let AI describe what you captured.
    </p>
    <div class="bingo-hero__cta-row">
      <button id="uph-start" class="bingo-hero__cta bingo-hero__cta--primary">Start a new card</button>
      <button id="uph-continue" class="bingo-hero__cta bingo-hero__cta--secondary" hidden>Continue your card</button>
    </div>
    <p id="uph-status" class="bingo-hero__status" aria-live="polite"></p>
  </header>

  <section class="bingo-section bingo-section--about">
    <h2 class="bingo-section__title">How it works</h2>
    <div class="bingo-section__body">
      <p>This app is rebranded for <a href="{{unihackUrl}}" target="_blank" rel="noopener">Unihack</a>. The stack:</p>
      <ul>
        <li><strong>Thalia</strong> — lightweight Bun-based web framework (Handlebars, Drizzle ORM, multi-site).</li>
        <li><strong>Mistral AI</strong> — vision API to describe each photo you upload for a bingo cell.</li>
        <li><strong>UploadThing</strong> — client uploads images; we send the URL to our server and Mistral.</li>
        <li><strong>D3.js</strong> — card grid is drawn on the client from a JSON game state; fast load, then fetch.</li>
        <li><strong>Socket.IO</strong> — real-time updates (e.g. when a cell is filled) for a smoother experience.</li>
      </ul>
      <p>Organisers create events with a list of prompts (e.g. “Team photo”, “Photo of your hardware setup”). Players join the Unihack event, get a randomised 3×3 photo-hunt card (no free space), then tap each prompt to take or upload a photo. We run the image through Mistral, store the description on the card, and you can review everything later on the admin dashboard.</p>
    </div>
  </section>

  <section class="bingo-section bingo-section--hackathon">
    <h2 class="bingo-section__title">Play at Unihack</h2>
    <div class="bingo-hackathon">
      <h3 class="bingo-hackathon__title">Unihack Photo Hunt</h3>
      <a href="{{unihackUrl}}" class="bingo-hackathon__link" target="_blank" rel="noopener">unihack.net →</a>
      <p class="bingo-hackathon__meta">Capture the energy of the hackathon: teams, mentors, venue details, late-night coding sessions, and demos.</p>
      <p class="bingo-hackathon__subtitle">How to play</p>
      <ul class="bingo-hackathon__list">
        <li>Click <strong>Start a new card</strong> to get a fresh 3×3 grid of Unihack prompts.</li>
        <li>Tap any prompt to take or upload a photo from your phone or laptop.</li>
        <li>We send the image to Mistral, describe what’s in it, and store it on your card.</li>
        <li>Come back to this page on the same device to <strong>continue your card</strong> from local storage.</li>
        <li>When you’re happy with your photos, <strong>save your card</strong> by creating an account with your email.</li>
      </ul>
    </div>
  </section>
</div>

<script>
  (function () {
    const STORAGE_KEY = 'uph_card_id';
    const JOIN_URL = '{{joinUrl}}';

    function getStoredCardId() {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const n = parseInt(raw, 10);
        return Number.isFinite(n) && n > 0 ? n : null;
      } catch {
        return null;
      }
    }

    function setStoredCardId(id) {
      try {
        window.localStorage.setItem(STORAGE_KEY, String(id));
      } catch {
        // ignore
      }
    }

    function init() {
      var startBtn = document.getElementById('uph-start');
      var continueBtn = document.getElementById('uph-continue');
      var statusEl = document.getElementById('uph-status');
      if (!startBtn || !continueBtn || !statusEl) return;

      var existing = getStoredCardId();
      if (existing) {
        continueBtn.hidden = false;
        statusEl.textContent = 'Welcome back – continue your card or start a fresh one.';
      }

      startBtn.addEventListener('click', function () {
        statusEl.textContent = 'Creating a new photo-hunt card…';
        window.localStorage.removeItem(STORAGE_KEY);
        window.location.href = JOIN_URL;
      });

      continueBtn.addEventListener('click', function () {
        var id = getStoredCardId();
        if (!id) {
          statusEl.textContent = 'No saved card found on this device. Starting a new one instead.';
          window.location.href = JOIN_URL;
          return;
        }
        window.location.href = '/bingo/' + id;
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
