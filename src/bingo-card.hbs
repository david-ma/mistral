<div class="bingo-page bingo-play">
  <a href="/list-events" class="bingo-page__back">&larr; Events</a>
  <h1 class="bingo-page__title" id="bingoTitle">Bingo{{#if eventName}}: {{eventName}}{{/if}}</h1>
  <p class="bingo-page__lead bingo-play__instructions">Click a prompt to take or upload a photo. We’ll analyse it and add it to your card.</p>

  <div id="bingo-card-root" data-card-id="{{cardId}}"></div>

  <input type="file" id="bingoFileInput" class="bingo-file-input" accept="image/*" capture="environment" />
</div>

<script type="module" src="/js/uploadthing-init.js"></script>
<script type="module" src="/js/bingo-game.js"></script>
