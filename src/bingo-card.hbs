<style>
  .bingo-grid { display: grid; gap: 0.5rem; margin: 1rem 0; }
  .bingo-grid.size-3 { grid-template-columns: repeat(3, 1fr); }
  .bingo-grid.size-5 { grid-template-columns: repeat(5, 1fr); }
  .bingo-cell {
    aspect-ratio: 1;
    border: 2px solid #ccc;
    border-radius: 8px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    background: #fafafa;
    min-height: 80px;
  }
  .bingo-cell:hover { border-color: #0d6efd; background: #f0f7ff; }
  .bingo-cell.bingo-free-space { background: #e0e0e0; cursor: default; }
  .bingo-cell.bingo-free-space:hover { border-color: #ccc; background: #e0e0e0; }
  .bingo-cell.filled { background: #e8f5e9; }
  .bingo-cell .cell-prompt { font-size: 0.85rem; font-weight: 600; margin-bottom: 0.25rem; }
  .bingo-cell .cell-image { max-width: 100%; max-height: 60px; object-fit: contain; border-radius: 4px; }
  .bingo-cell .cell-desc { font-size: 0.7rem; color: #666; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  input[type="file"].bingo-file-input { display: none; }
</style>

<p><a href="/list-events">&larr; Events</a></p>
<h1>Bingo{{#if eventName}}: {{eventName}}{{/if}}</h1>
<p class="text-muted">Click a prompt to take or upload a photo. We’ll analyse it and add it to your card.</p>

<div class="bingo-grid size-{{gridSize}}" id="bingoGrid" data-card-id="{{cardId}}">
  {{#each cells}}
    <div class="bingo-cell {{#if this.imageUrl}}filled{{/if}} {{#if this.isFreeSpace}}bingo-free-space{{/if}}" data-cell-index="{{@index}}" {{#if this.isFreeSpace}}data-free-space="1"{{/if}} tabindex="0">
      <span class="cell-prompt">{{this.prompt}}</span>
      {{#if this.imageUrl}}
        <img src="{{this.imageUrl}}" alt="" class="cell-image" />
        {{#if this.description}}<span class="cell-desc">{{this.description}}</span>{{/if}}
      {{else}}
        {{#unless this.isFreeSpace}}<span class="text-muted small">Tap to add photo</span>{{/unless}}
      {{/if}}
    </div>
  {{else}}
    <p class="text-muted">No cells on this card. <a href="/list-events">Join an event</a> to get a new card.</p>
  {{/each}}
</div>

<input type="file" id="bingoFileInput" class="bingo-file-input" accept="image/*" capture="environment" />

<script type="module" src="/js/uploadthing-init.js"></script>
<script type="module" src="/js/bingo-game.js"></script>
<script>
(function() {
  var grid = document.getElementById('bingoGrid');
  var fileInput = document.getElementById('bingoFileInput');
  if (!grid || !fileInput) return;
  var cardId = parseInt(grid.getAttribute('data-card-id'), 10);
  if (!Number.isFinite(cardId)) return;

  var currentCellIndex = null;

  function openPicker(cellIndex) {
    currentCellIndex = cellIndex;
    fileInput.click();
  }

  grid.querySelectorAll('.bingo-cell').forEach(function(cell) {
    if (cell.getAttribute('data-free-space') === '1') return;
    var idx = parseInt(cell.getAttribute('data-cell-index'), 10);
    cell.addEventListener('click', function() { openPicker(idx); });
    cell.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPicker(idx); } });
  });

  fileInput.addEventListener('change', function() {
    var file = fileInput.files && fileInput.files[0];
    fileInput.value = '';
    if (!file || currentCellIndex === null) return;
    var cell = grid.querySelector('.bingo-cell[data-cell-index="' + currentCellIndex + '"]');
    if (!cell) return;

    var uploadFiles = window.uploadFilesToUploadThing;
    if (!uploadFiles) {
      alert('Upload not available. Check that UploadThing is loaded.');
      return;
    }

    cell.classList.add('loading');
    if (cell.querySelector('.cell-loading')) cell.querySelector('.cell-loading').textContent = 'Uploading…';
    else { var loading = document.createElement('span'); loading.className = 'cell-loading text-muted small'; cell.appendChild(loading); loading.textContent = 'Uploading…'; }

    uploadFiles('smugmugImage', { files: [file] })
      .then(function(results) {
        var url = (results && results[0] && results[0].url) || (results && results.url) || (results && results.data && results.data[0] && results.data[0].url);
        if (!url) throw new Error('No URL returned from upload');
        if (cell.querySelector('.cell-loading')) cell.querySelector('.cell-loading').textContent = 'Analysing…';
        var payload = { cardId: Number(cardId), cellIndex: Number(currentCellIndex), imageUrl: String(url) };
        return fetch('/api/bingo-cell', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        }).then(function(r) { return r.json(); }).then(function(data) {
          if (data.error) throw new Error(data.error);
          return data;
        });
      })
      .then(function(data) {
        var loadingEl = cell.querySelector('.cell-loading');
        if (loadingEl) loadingEl.remove();
        cell.classList.remove('loading');
        cell.classList.add('filled');
        var promptEl = cell.querySelector('.cell-prompt');
        var oldImg = cell.querySelector('.cell-image');
        if (oldImg) oldImg.remove();
        var oldDesc = cell.querySelector('.cell-desc');
        if (oldDesc) oldDesc.remove();
        var oldHint = cell.querySelector('.text-muted.small');
        if (oldHint) oldHint.remove();
        var img = document.createElement('img');
        img.src = data.cell.imageUrl;
        img.alt = '';
        img.className = 'cell-image';
        cell.insertBefore(img, promptEl.nextSibling);
        if (data.cell.description) {
          var desc = document.createElement('span');
          desc.className = 'cell-desc';
          desc.textContent = data.cell.description;
          cell.appendChild(desc);
        }
      })
      .catch(function(err) {
        var loadingEl = cell.querySelector('.cell-loading');
        if (loadingEl) loadingEl.textContent = 'Error: ' + (err && err.message ? err.message : String(err));
        else cell.appendChild(document.createTextNode('Error: ' + (err && err.message ? err.message : String(err))));
        cell.classList.remove('loading');
      });

    currentCellIndex = null;
  });
})();
</script>
