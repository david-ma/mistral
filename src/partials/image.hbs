{{!-- Override of Thalia image.hbs: fix image_preview typo, add optional albumKey for uploads to current album --}}
<style>
  #uploadImageLabel {
    font-size: 16px;
    font-family: 'Bobby Jones', 'Comico', cursive;
  }

  #uploadImageLabel:hover {
    pointer: cursor;
  }

  #imageHelpText {
    background: none;
  }

  .image-container {
    width: 200px;
    height: 100px;
    border: 1px dotted #999;
    padding: 10px;
    transition: all 0.3s ease;
  }

  .image-container.drag-over {
    border: 2px dashed #007bff;
    background-color: rgba(0, 123, 255, 0.1);
    transform: scale(1.02);
  }

  .image-container.drag-over #imageHelpText {
    color: #007bff;
  }
</style>

<div class="image-container" id="dropZone">
  <label id="uploadImageLabel" for="fileToUpload">
    <div id="image_previews">
      <img id="loading" alt="" />
    </div>
    <span id="imageHelpText">Click to upload image or drag &amp; drop</span>
  </label>

  <form id="imageForm" style="display: none;">
    <input type="file" accept="image/*" name="fileToUpload" id="fileToUpload" multiple/>
    {{#if albumKey}}<input type="hidden" name="albumKey" id="imageFormAlbumKey" value="{{albumKey}}" />{{/if}}
  </form>
</div>

<br />

<script type="module" src="/js/uploadthing-init.js"></script>
<script>
  (function() {
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileToUpload');
    const imageHelpText = document.getElementById('imageHelpText');

    if (!dropZone || !fileInput || !imageHelpText) return;

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function(eventName) {
      dropZone.addEventListener(eventName, function(e) {
        e.preventDefault();
        e.stopPropagation();
      }, false);
      document.body.addEventListener(eventName, function(e) {
        e.preventDefault();
        e.stopPropagation();
      }, false);
    });

    ['dragenter', 'dragover'].forEach(function(eventName) {
      dropZone.addEventListener(eventName, function() {
        dropZone.classList.add('drag-over');
      }, false);
    });

    ['dragleave', 'drop'].forEach(function(eventName) {
      dropZone.addEventListener(eventName, function() {
        dropZone.classList.remove('drag-over');
      }, false);
    });

    dropZone.addEventListener('drop', function(e) {
      const dt = e.dataTransfer;
      const files = dt.files;
      fileInput.files = files;
      handleFiles({ target: { files: files } });
    }, false);

    fileInput.addEventListener('change', handleFiles, false);

    function showResult(data, loadingEl, previews) {
      if (loadingEl) loadingEl.src = '';
      imageHelpText.textContent = 'Image uploaded!';
      if (previews && data.thumbnailUrl) {
        previews.innerHTML += '<img src="' + data.thumbnailUrl.replace(/"/g, '&quot;') + '" alt="" />';
      }
    }

    function showError(loadingEl) {
      if (loadingEl) loadingEl.src = '';
      imageHelpText.textContent = 'Error. Try again :(';
    }

    function sendToSmugmug(uploadThingUrl, albumKey, filename, fileKey, fileSize, loadingEl, previews) {
      var xhr = new XMLHttpRequest();
      xhr.open('POST', '/uploadPhoto');
      xhr.setRequestHeader('Content-Type', 'application/json');
      xhr.onload = function() {
        if (xhr.status >= 200 && xhr.status < 300) {
          try {
            var data = JSON.parse(xhr.responseText);
            showResult(data, loadingEl, previews);
          } catch (e) {
            showError(loadingEl);
          }
        } else {
          try {
            var errData = JSON.parse(xhr.responseText);
            if (errData && errData.error) {
              imageHelpText.textContent = errData.error;
            } else {
              showError(loadingEl);
            }
          } catch (e) {
            showError(loadingEl);
          }
          if (loadingEl) loadingEl.src = '';
        }
      };
      xhr.onerror = function() { showError(loadingEl); };
      xhr.send(JSON.stringify({
        uploadThingUrl: uploadThingUrl,
        albumKey: albumKey,
        filename: filename || 'image.jpg',
        fileKey: fileKey || null,
        size: fileSize != null ? fileSize : null
      }));
    }

    function legacyFormUpload(file, albumKey, loadingEl, previews) {
      var formData = new FormData();
      formData.append('fileToUpload', file);
      formData.append('caption', '');
      formData.append('filename', file.name);
      formData.append('title', file.name);
      formData.append('keywords', '');
      if (albumKey) formData.append('albumKey', albumKey);

      var xhr = new XMLHttpRequest();
      xhr.open('POST', '/uploadPhoto');
      xhr.onload = function() {
        if (xhr.status >= 200 && xhr.status < 300) {
          try {
            var data = JSON.parse(xhr.responseText);
            showResult(data, loadingEl, previews);
          } catch (e) {
            showError(loadingEl);
          }
        } else {
          showError(loadingEl);
        }
      };
      xhr.onerror = function() { showError(loadingEl); };
      xhr.send(formData);
    }

    function handleFiles(event) {
      if (!event.target.files || event.target.files.length === 0) return;
      var files = event.target.files;
      var albumKeyEl = document.getElementById('imageFormAlbumKey');
      var albumKey = albumKeyEl ? albumKeyEl.value : '';
      var loadingEl = document.getElementById('loading');
      var previews = document.getElementById('image_previews');

      Array.from(files).forEach(function(file) {
        if (!file.type.startsWith('image/')) {
          alert('Please select an image file');
          return;
        }
        imageHelpText.textContent = 'Uploading image... please wait';
        if (loadingEl) loadingEl.src = '/images/loading.gif';

        if (window.uploadFilesToUploadThing && albumKey) {
          window.uploadFilesToUploadThing('smugmugImage', { files: [file] })
            .then(function(results) {
              var r = results && results[0];
              if (r && r.url) {
                sendToSmugmug(r.url, albumKey, file.name, r.key || null, r.size != null ? r.size : null, loadingEl, previews);
              } else {
                showError(loadingEl);
              }
            })
            .catch(function(err) {
              console.warn('UploadThing failed, falling back to legacy upload', err);
              legacyFormUpload(file, albumKey, loadingEl, previews);
            });
        } else {
          if (!albumKey) {
            imageHelpText.textContent = 'Select an album first, or use the upload on an album page.';
            if (loadingEl) loadingEl.src = '';
          } else {
            legacyFormUpload(file, albumKey, loadingEl, previews);
          }
        }
      });
    }
  })();
</script>
