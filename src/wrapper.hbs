<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/main.css" />
  {{> styles}}
  {{> scripts}}
  <style>
    .nav { background: #f8f9fa; border-bottom: 1px solid #dee2e6; }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 0.75rem 0; }
    .nav-brand { font-weight: 700; font-size: 1.25rem; color: #333; text-decoration: none; }
    .nav-links { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.25rem; }
    .nav-links a { color: #337ab7; text-decoration: none; }
    .nav-links a:hover { text-decoration: underline; }
    .main { padding-top: 1.5rem; padding-bottom: 2rem; }
  </style>
</head>
<body>
  {{> nav}}
  <main class="main container">
    {{> content}}
  </main>
  {{> footer}}
</body>
</html>
