<h1>Albums</h1>
<p>Select an album to view its images. <a href="/create-album">Create new album</a></p>
<ul class="album-list">
  {{#each albums}}
    <li>
      <a href="/album/{{this.slugEncoded}}">{{this.name}}</a>
      {{#if this.urlName}}<span class="text-muted"> ({{this.urlName}})</span>{{/if}}
    </li>
  {{else}}
    <li>No albums found.</li>
  {{/each}}
</ul>
